<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SharpClip.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="ClipHost" Background="Transparent" SizeChanged="OnClipSize">
    <Grid x:Name="Root" Background="Transparent" IsTabStop="True" PreviewKeyDown="OnPreviewKey" KeyUp="OnKeyUp">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="FilterBar" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <ScrollViewer
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                VerticalScrollMode="Disabled">
                <StackPanel x:Name="TabBar" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
            </ScrollViewer>
            <StackPanel x:Name="SideBar" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <StackPanel x:Name="ActionBar" Visibility="Collapsed" />
        </Grid>

        <ScrollViewer
            x:Name="CardScroller"
            Grid.Row="1"
            Padding="20,18"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled"
            PointerWheelChanged="OnCardWheel">
            <StackPanel x:Name="CardRow" Orientation="Horizontal" Spacing="22" VerticalAlignment="Center" />
        </ScrollViewer>

        <StackPanel x:Name="EmptyState" Grid.Row="1" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="EmptyTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyBody" FontSize="12" Opacity="0.65" HorizontalAlignment="Center" />
        </StackPanel>

        <Canvas x:Name="DragLayer" Grid.RowSpan="2" IsHitTestVisible="False" />

        <Grid x:Name="PreviewLayer" Grid.Row="1" Visibility="Collapsed" Background="#66000000" Tapped="OnPreviewDismiss">
            <Border x:Name="PreviewCard" MaxWidth="760" Padding="18" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer MaxHeight="250">
                    <StackPanel>
                        <Image x:Name="PreviewImage" MaxHeight="210" Stretch="Uniform" Visibility="Collapsed" />
                        <TextBlock x:Name="PreviewText" FontSize="14" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
    </Grid>
</Window>
